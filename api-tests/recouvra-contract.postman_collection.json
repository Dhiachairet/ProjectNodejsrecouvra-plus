        {
          "name": "CT-P-API-09 créer un client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json().client;",
                  "pm.test(\"shape: client._id\", () => pm.expect(c._id).to.match(/^[0-9a-f]{24}$/));",
                  "pm.environment.set(\"clientId\", c._id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"stamp\", Date.now());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
