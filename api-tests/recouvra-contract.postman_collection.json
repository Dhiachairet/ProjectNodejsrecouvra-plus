              "raw": "{{baseUrl}}/clients?page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
