            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceNumber\": \"NEWMAN-{{stamp}}\",\n  \"client\": \"{{clientId}}\",\n  \"amount\": 1000,\n  \"dueDate\": \"{{dueDate}}\"\n}"
            }
          }
        },
