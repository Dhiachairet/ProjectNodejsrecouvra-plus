            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman {{stamp}}\",\n  \"email\": \"newman{{stamp}}@api.tn\",\n  \"phone\": \"71000000\",\n  \"company\": \"API SARL\"\n}"
            }
          }
        },
        {
          "name": "CT-P-API-10 créer une facture de 1000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const i = pm.response.json().invoice;",
                  "pm.test(\"statut calculé unpaid\", () => pm.expect(i.status).to.eql(\"unpaid\"));",
                  "pm.environment.set(\"invoiceId\", i._id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 30); pm.environment.set(\"dueDate\", d.toISOString().slice(0, 10));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
